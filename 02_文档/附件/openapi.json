  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "questionId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "title": "Questionid"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "type": "array",
                "maxItems": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "questionId",
          "value"
        ],
        "title": "Answer"
      },
      "EndTarget": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "end",
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "EndTarget"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MultipleCondition": {
        "properties": {
          "operator": {
            "type": "string",
            "enum": [
              "containsAny",
              "containsAll",
              "setEquals"
            ],
            "title": "Operator"
          },
          "values": {
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Values"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operator",
          "values"
        ],
        "title": "MultipleCondition"
      },
      "MultipleQuestion": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "title": "Description",
            "default": ""
          },
          "required": {
            "type": "boolean",
            "title": "Required",
            "default": true
          },
          "type": {
            "type": "string",
            "const": "multiple",
            "title": "Type"
          },
          "validation": {
            "$ref": "#/components/schemas/MultipleValidation"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 2,
            "title": "Options"
          },
          "jumpRules": {
            "items": {
              "$ref": "#/components/schemas/MultipleRule"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Jumprules"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "options"
        ],
        "title": "MultipleQuestion"
      },
      "MultipleRule": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "title": "Id"
          },
          "condition": {
            "$ref": "#/components/schemas/MultipleCondition"
          },
          "target": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/QuestionTarget"
              },
              {
                "$ref": "#/components/schemas/EndTarget"
              }
            ],
            "title": "Target",
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "end": "#/components/schemas/EndTarget",
                "question": "#/components/schemas/QuestionTarget"
              }
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "condition",
          "target"
        ],
        "title": "MultipleRule"
      },
      "MultipleValidation": {
        "properties": {
          "minSelections": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 50.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Minselections"
          },
          "maxSelections": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 50.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Maxselections"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "MultipleValidation"
      },
      "NumberBetweenCondition": {
        "properties": {
          "operator": {
            "type": "string",
            "const": "between",
            "title": "Operator"
          },
          "min": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "title": "Min"
          },
          "max": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "title": "Max"
          }
        },
