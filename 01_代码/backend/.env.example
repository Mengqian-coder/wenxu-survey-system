# Copy to backend/.env; replace this placeholder before starting the API.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-of-at-least-64-characters
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
MONGODB_DATABASE=survey_system
ACCESS_TOKEN_MINUTES=120
SUBMISSION_TOKEN_MINUTES=1440
AUTO_INIT_DB=true
# JSON array. Set actual frontend origin when needed, e.g. ["http://localhost:5173"]
CORS_ORIGINS=[]
MAX_REQUEST_BYTES=12582912
